{
  "mcpServers": {
    "remarkable": {
      "command": "/FULL/PATH/TO/uvx",
      "args": [
        "--from",
        "/FULL/PATH/TO/remarkable-distill/vendor/remarkable-mcp",
        "remarkable-mcp",
        "--usb"
      ],
      "env": {
        "REMARKABLE_OCR_BACKEND": "sampling",
        "DYLD_FALLBACK_LIBRARY_PATH": "/opt/homebrew/lib:/usr/local/lib"
      }
    }
  }
}
